# VITE_API_URL: Set this if your backend is hosted on a different domain and you don't want to use Vite proxy.
# VITE_API_URL=https://api.yourstaging.com/api/v1

# BACKEND_URL: Used by the Vite dev server proxy to route /api requests. 
# In AI Studio, set this via the Secrets UI or in .env to point to your real staging backend.
# Example:
# BACKEND_URL=https://api.yourstaging.com
