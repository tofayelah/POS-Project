{
  "name": "retailcore-workspace",
  "private": true,
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=frontend",
    "build": "npm run build --workspace=frontend && cp -r frontend/dist ./dist",
    "lint": "npm run lint --workspace=frontend",
    "test": "npm run test --workspace=frontend"
  },
  "devDependencies": {
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "axios": "^1.20.0",
    "date-fns": "^4.4.0",
    "recharts": "^3.10.1",
    "tailwindcss": "^4.3.3"
  }
}
